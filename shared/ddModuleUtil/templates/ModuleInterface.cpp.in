#endif
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
void ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyDataContext(
    DDModuleDataContext* phDataContext)
{
#if DD_GEN_MODULE_IS_EXTENSION_MODULE
    ${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}DestroyDataContext(phDataContext);
#else
    #if DD_GEN_MODULE_SUPPORTS_DATA_CONTEXT
        if (phDataContext != nullptr)
        {
            const DDModuleDataContext hDataContext = *phDataContext;

            if (hDataContext != nullptr)
            {
                auto pDataContext =
                    reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}*>(hDataContext);

                // Destroy the context object
                const DDAllocCallbacks apiAllocCb = pDataContext->GetLoader().apiAllocCb;
                pDataContext->~${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}();
                apiAllocCb.pfnFree(apiAllocCb.pUserdata, pDataContext);

                // Null out the caller's handle once we're done
                *phDataContext = nullptr;
            }
        }
    #else
        DD_API_UNUSED(phDataContext);
        // Do nothing
    #endif
#endif
}

