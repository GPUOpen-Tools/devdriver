////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DD_RESULT ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateCommandContext(
    const DDModuleCommandContextCreateInfo* pCreateInfo,
    DDModuleCommandContext*                 phCommandContext)
{
    DD_RESULT result = DD_RESULT_COMMON_INVALID_PARAMETER;

    // Copy the user data locally. We'll validate it in place and pass it down to AppContext::Init();
    DDModuleCommandContextCreateInfo createInfo = {};

    // Validate input arguments
    if ((pCreateInfo != nullptr) && (phCommandContext != nullptr))
    {
        result     = DD_RESULT_SUCCESS;
        createInfo = *pCreateInfo;
    }

    // Validate the logging callbacks
    if (result == DD_RESULT_SUCCESS)
    {
        // Only simple pfnLog is required.
        if (createInfo.loggerInfo.pfnLog == nullptr)
        {
            result = DD_RESULT_COMMON_INVALID_PARAMETER;
        }
    }

    if (result == DD_RESULT_SUCCESS)
    {
        result = DD_RESULT_COMMON_OUT_OF_HEAP_MEMORY;
        // Use default allocator.
        const auto& allocCb = DevDriver::Platform::GenericAllocCb;

        void* pMemory = allocCb.pfnAlloc(allocCb.pUserdata,
                                         sizeof(${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}),
                                         alignof(${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}),
                                         0);

        if (pMemory != nullptr)
        {
            auto* pContext = new(pMemory) ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}(createInfo);
            result = pContext->Initialize();
            if (result == DD_RESULT_SUCCESS)
            {
                (*phCommandContext) = reinterpret_cast<DDModuleCommandContext>(pContext);
            }
            else
            {
                pContext->~${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}();
                allocCb.pfnFree(allocCb.pUserdata, pMemory);
            }
        }
    }

    return result;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
void ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyCommandContext(
    DDModuleCommandContext hCommandContext)
{
    assert(hCommandContext != nullptr);

    auto pContext =
        reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}*>(hCommandContext);

    // Destroy the context object
    const auto& allocCb = DevDriver::Platform::GenericAllocCb;
    pContext->~${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}();
    allocCb.pfnFree(allocCb.pUserdata, pContext);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
void ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryCommands(
    DDModuleCommandContext             hCommandContext,
    uint32_t*                          pNumCommands,
    const DDModuleCommandDescription** ppCommands)
{
    assert(hCommandContext != nullptr);

    auto pContext =
            reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}*>(hCommandContext);

    pContext->QueryCommands(pNumCommands, ppCommands);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DD_RESULT ${DD_GEN_MODULE_ARGS_MODULE_NAME}ExecuteCommand(
    DDModuleCommandContext  hCommandContext,
    const char*             pCommandName,
    uint32_t                numParameters,
    const CommandParameter* pParameters,
    const DDByteWriter*     pWriter)
{
    assert(hCommandContext != nullptr);

    auto pContext =
            reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_COMMAND_CONTEXT_CLASS_NAME}*>(hCommandContext);

    return pContext->ExecuteCommand(pCommandName, numParameters, pParameters, pWriter);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
const DDModuleExtensionInterface* ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryCommandExtension(
    DDModuleExtensionId id)
{
    const DDModuleExtensionInterface* pInterface = nullptr;

    if (id == COMMAND_EXTENSION_ID)
    {
        static const DDModuleExtensionInterface kExtensionInterface = []()
        {
            DDModuleExtensionInterface extensionInterface = {};

            extensionInterface.description.id           = COMMAND_EXTENSION_ID;
            extensionInterface.description.pName        = COMMAND_EXTENSION_NAME;
            extensionInterface.description.pDescription = COMMAND_EXTENSION_DESCRIPTION;

            static const CommandExtApi_0000 kApi = []() -> CommandExtApi_0000
            {
                CommandExtApi_0000 api = {};

                api.pfnCreateContext  = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateCommandContext;
                api.pfnDestroyContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyCommandContext;
                api.pfnQueryCommands  = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryCommands;
                api.pfnExecuteCommand = ${DD_GEN_MODULE_ARGS_MODULE_NAME}ExecuteCommand;

                return api;
            }();

            extensionInterface.pApi = reinterpret_cast<DDModuleExtensionApi>(&kApi);

            extensionInterface.apiVersion.major = COMMAND_EXTENSION_VERSION_MAJOR;
            extensionInterface.apiVersion.minor = COMMAND_EXTENSION_VERSION_MINOR;
            extensionInterface.apiVersion.patch = COMMAND_EXTENSION_VERSION_PATCH;

            return extensionInterface;
        }();

        pInterface = &kExtensionInterface;
    }

    return pInterface;
}
#endif

