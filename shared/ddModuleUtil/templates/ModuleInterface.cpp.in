#endif
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
const DDModuleInterface* ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryModuleInterface(
    void)
{
#if DD_GEN_MODULE_IS_EXTENSION_MODULE
    static const DDModuleInterface kModuleInterface = []()
    {
        // Extract the existing module interface from the base module
        DDModuleInterface moduleInterface = *${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}QueryModuleInterface();

        // Generate new API tables that reference our module functions instead of the base module functions.
        static const DDModuleClientContextApi_0000 kClientContextApi = []() -> DDModuleClientContextApi_0000
        {
            DDModuleClientContextApi_0000 clientContextApi = {};

            clientContextApi.pfnQueryModuleClientContextAllocInfo = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryModuleClientContextAllocInfo;
            clientContextApi.pfnCreateModuleClientContext         = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateModuleClientContext;
            clientContextApi.pfnDestroyModuleClientContext        = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyModuleClientContext;
            clientContextApi.pfnHandleClientEvent                 = ${DD_GEN_MODULE_ARGS_MODULE_NAME}HandleClientEvent;

            return clientContextApi;
        }();

        static const DDModuleDataContextApi_0000 kDataContextApi = []() -> DDModuleDataContextApi_0000
        {
            DDModuleDataContextApi_0000 dataContextApi = {};

            dataContextApi.pfnCreateDataContext    = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateDataContext;
            dataContextApi.pfnDestroyDataContext   = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyDataContext;
            dataContextApi.pfnSerializeDataContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}SerializeDataContext;

            return dataContextApi;
        }();

        static const DDModuleSystemContextApi_0000 kSystemContextApi = []() -> DDModuleSystemContextApi_0000
        {
            DDModuleSystemContextApi_0000 systemContextApi = {};

            systemContextApi.pfnCreateModuleSystemContext  = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateModuleSystemContext;
            systemContextApi.pfnDestroyModuleSystemContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyModuleSystemContext;
            systemContextApi.pfnHandleSystemEvent          = ${DD_GEN_MODULE_ARGS_MODULE_NAME}HandleSystemEvent;

            return systemContextApi;
        }();

        static const DDModuleApi_0000 kModuleApi = []() -> DDModuleApi_0000
        {
            DDModuleApi_0000 moduleApi = {};

            moduleApi.pClientContextApi = &kClientContextApi;
            moduleApi.pDataContextApi   = &kDataContextApi;
            moduleApi.pSystemContextApi = &kSystemContextApi;
            moduleApi.pfnQueryExtension = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryExtension;

            return moduleApi;
        }();

        // Overlay the updated api tables
        moduleInterface.pApi = reinterpret_cast<DDModuleApi>(&kModuleApi);

        return moduleInterface;
    }();
#else
    static const DDModuleInterface kModuleInterface = []()
    {
        DDModuleInterface moduleInterface = {};

        moduleInterface.description.pName        = "${DD_GEN_MODULE_ARGS_MODULE_NAME}";
        moduleInterface.description.pDescription = "${DD_GEN_MODULE_ARGS_MODULE_DESCRIPTION}";

        moduleInterface.description.moduleVersion.major = ${DD_GEN_MODULE_ARGS_MODULE_VERSION_MAJOR};
        moduleInterface.description.moduleVersion.minor = ${DD_GEN_MODULE_ARGS_MODULE_VERSION_MINOR};
        moduleInterface.description.moduleVersion.patch = ${DD_GEN_MODULE_ARGS_MODULE_VERSION_PATCH};

#if DD_GEN_MODULE_SUPPORTS_SYSTEM_CONTEXT
        moduleInterface.description.flags.fields.supportsSystemContexts = 1;
        static const DDModuleSystemContextApi_0000 kSystemContextApi = []() -> DDModuleSystemContextApi_0000
        {
            DDModuleSystemContextApi_0000 systemContextApi = {};

            systemContextApi.pfnCreateModuleSystemContext  = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateModuleSystemContext;
            systemContextApi.pfnDestroyModuleSystemContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyModuleSystemContext;
            systemContextApi.pfnHandleSystemEvent          = ${DD_GEN_MODULE_ARGS_MODULE_NAME}HandleSystemEvent;

            return systemContextApi;
        }();
#endif

#if DD_GEN_MODULE_SUPPORTS_CLIENT_CONTEXT
        moduleInterface.description.flags.fields.supportsClientContexts = 1;
        static const DDModuleClientContextApi_0000 kClientContextApi = []() -> DDModuleClientContextApi_0000
        {
            DDModuleClientContextApi_0000 clientContextApi = {};

            clientContextApi.pfnQueryModuleClientContextAllocInfo = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryModuleClientContextAllocInfo;
            clientContextApi.pfnCreateModuleClientContext         = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateModuleClientContext;
            clientContextApi.pfnDestroyModuleClientContext        = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyModuleClientContext;
            clientContextApi.pfnHandleClientEvent                 = ${DD_GEN_MODULE_ARGS_MODULE_NAME}HandleClientEvent;

            return clientContextApi;
        }();
#endif

        // Basic data context support must always be provided in order to support app profile instances
        moduleInterface.description.flags.fields.supportsDataContexts = 1;
        static const DDModuleDataContextApi_0000 kDataContextApi = []() -> DDModuleDataContextApi_0000
        {
            DDModuleDataContextApi_0000 dataContextApi = {};

            dataContextApi.pfnCreateDataContext    = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateDataContext;
            dataContextApi.pfnDestroyDataContext   = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyDataContext;
            dataContextApi.pfnSerializeDataContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}SerializeDataContext;

            return dataContextApi;
        }();

#if DD_GEN_MODULE_SUPPORTS_CONNECTION_CONTEXT
        moduleInterface.description.flags.fields.supportsConnectionContexts = 1;
        static const DDModuleConnectionContextApi_0000 kConnectionContextApi = []() -> DDModuleConnectionContextApi_0000 {
            DDModuleConnectionContextApi_0000 connectionContextClient = {};

            connectionContextClient.pfnCreateConnectionContext  = ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateConnectionContext;
            connectionContextClient.pfnDestroyConnectionContext = ${DD_GEN_MODULE_ARGS_MODULE_NAME}DestroyConnectionContext;

            return connectionContextClient;
        }();
#endif

        static const DDModuleApi_0000 kModuleApi = []() -> DDModuleApi_0000
        {
            DDModuleApi_0000 moduleApi = {};

#if DD_GEN_MODULE_SUPPORTS_SYSTEM_CONTEXT
            moduleApi.pSystemContextApi = &kSystemContextApi;
#endif

#if DD_GEN_MODULE_SUPPORTS_CLIENT_CONTEXT
            moduleApi.pClientContextApi = &kClientContextApi;
#endif

            // Basic data context support must always be provided in order to support app profile instances
            moduleApi.pDataContextApi = &kDataContextApi;

#if DD_GEN_MODULE_SUPPORTS_CONNECTION_CONTEXT
            moduleApi.pConnectionContextApi = &kConnectionContextApi;
#endif

            moduleApi.pfnQueryExtension = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryExtension;

            return moduleApi;
        }();

        moduleInterface.pApi = reinterpret_cast<DDModuleApi>(&kModuleApi);

        moduleInterface.apiVersion.major = DD_MODULE_API_MAJOR_VERSION;
        moduleInterface.apiVersion.minor = DD_MODULE_API_MINOR_VERSION;
        moduleInterface.apiVersion.patch = DD_MODULE_API_PATCH_VERSION;

        return moduleInterface;
    }();
#endif
    return &kModuleInterface;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DDModuleCommonApi ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryCommonApi(void)
{
    static const DDModuleCommonApi kCommonApi = []()
    {
        DDModuleCommonApi commonApi = {};
        commonApi.pfnUpdateUserdataNode         = BaseModuleDataContext::UpdateUserdataNode;
        commonApi.pfnQueryUserdataNode          = BaseModuleDataContext::QueryUserdataNode;
        commonApi.pfnQuerySystemInfo            = BaseModuleSystemContext::QuerySystemInfo;
        commonApi.pfnQueryStatus                = BaseModuleClientContext::QueryStatus;
        commonApi.pfnQueryClientProtocolVersion = BaseModuleClientContext::QueryClientProtocolVersion;

        return commonApi;
    }();

    return kCommonApi;
}
