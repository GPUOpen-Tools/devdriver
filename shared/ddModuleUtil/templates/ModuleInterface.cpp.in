////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DD_RESULT ${DD_GEN_MODULE_ARGS_MODULE_NAME}CreateModuleClientContext(
    const DDModuleClientContextCreateInfo* pCreateInfo,
    void*                                  pContextMemory)
{
#if DD_GEN_MODULE_IS_EXTENSION_MODULE
    return ${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}CreateModuleClientContext(pCreateInfo, pContextMemory);
#else
    assert(pCreateInfo != nullptr);
    assert(pContextMemory != nullptr);

    #if DD_GEN_MODULE_SUPPORTS_CLIENT_CONTEXT
        // Placement new a client context on the provided memory
        ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}* pClientContext =
            new(pContextMemory) ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}(*pCreateInfo);

        const DD_RESULT result = pClientContext->Initialize();

        // Make sure we call the destructor if we fail to connect
        if (result != DD_RESULT_SUCCESS)
        {
            pClientContext->~${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}();
        }

        return result;
    #else
        DD_API_UNUSED(pCreateInfo);
        DD_API_UNUSED(pContextMemory);
        return DD_RESULT_COMMON_UNIMPLEMENTED;
    #endif
#endif
}

