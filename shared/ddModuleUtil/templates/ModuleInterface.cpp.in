    ${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}DestroyModuleClientContext(hClientContext);
#else
    #if DD_GEN_MODULE_SUPPORTS_CLIENT_CONTEXT
        // Call the destructor before our memory is deallocated
        ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}* pClientContext =
            reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}*>(hClientContext);
        pClientContext->~${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}();
    #else
        DD_API_UNUSED(hClientContext);
    #endif
#endif
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
void ${DD_GEN_MODULE_ARGS_MODULE_NAME}HandleClientEvent(
    DDModuleClientContext  hClientContext,
    DD_MODULE_CLIENT_EVENT eventId,
    const void*            pEventData,
    size_t                 eventDataSize)
{
#if DD_GEN_MODULE_IS_EXTENSION_MODULE
    ${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}HandleClientEvent(hClientContext, eventId, pEventData, eventDataSize);
#else
    #if DD_GEN_MODULE_SUPPORTS_CLIENT_CONTEXT
        switch (eventId)
        {
        case DD_MODULE_CLIENT_EVENT_STATE_CHANGED:
        {
            assert(eventDataSize == sizeof(DDModuleClientEventStateChanged));
            DD_API_UNUSED(eventDataSize);

            ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}* pClientContext =
                reinterpret_cast<${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_CLIENT_CONTEXT_CLASS_NAME}*>(hClientContext);

            pClientContext->HandleStateChanged(*reinterpret_cast<const DDModuleClientEventStateChanged*>(pEventData));

            break;
        }
        default:
            // Nothing to do for other events
            break;
        }
    #else
        DD_API_UNUSED(hClientContext);
        DD_API_UNUSED(eventId);
        DD_API_UNUSED(pEventData);
        DD_API_UNUSED(eventDataSize);
    #endif
#endif
}

