////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
const DDModuleExtensionInterface* ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryExtension(
    DDModuleExtensionId id)
{
    // Attempt to match the id with known extensions
    const DDModuleExtensionInterface* pInterface = ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::QueryExtension(id);

#if DD_GEN_MODULE_IS_EXTENSION_MODULE
    // If we are unable to identify the extension, pass it down to our base module implementation
    if (pInterface == nullptr)
    {
        pInterface = ${DD_GEN_MODULE_ARGS_BASE_MODULE_NAME}QueryExtension(id);
    }
#endif

#if DD_GEN_MODULE_SUPPORTS_COMMAND_CONTEXT
    // Handle the command extension if the module provided a context for it
    if (pInterface == nullptr)
    {
        pInterface = ${DD_GEN_MODULE_ARGS_MODULE_NAME}QueryCommandExtension(id);
    }
#endif

    return pInterface;
}

