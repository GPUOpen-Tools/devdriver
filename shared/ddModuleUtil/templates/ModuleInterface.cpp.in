        void* pMemory = apiAllocCb.pfnAlloc(apiAllocCb.pUserdata,
                                           sizeof(${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}),
                                           alignof(${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}),
                                           0);

        if (pMemory != nullptr)
        {
            auto* pContext = new(pMemory) ${DD_GEN_MODULE_ARGS_MODULE_NAMESPACE}::${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}(*pCreateInfo);
            result = pContext->Initialize(pData, dataSize);
            if (result == DD_RESULT_SUCCESS)
            {
                (*phDataContext) = reinterpret_cast<DDModuleDataContext>(pContext);
            }
            else
            {
                pContext->~${DD_GEN_MODULE_ARGS_DATA_CONTEXT_CLASS_NAME}();
                apiAllocCb.pfnFree(apiAllocCb.pUserdata, pMemory);
            }
        }

        return result;
    #else
        DD_API_UNUSED(pCreateInfo);
        DD_API_UNUSED(pData);
        DD_API_UNUSED(dataSize);

        (*phDataContext) = reinterpret_cast<DDModuleDataContext>(DD_API_INVALID_HANDLE);

        return DD_RESULT_COMMON_UNIMPLEMENTED;
